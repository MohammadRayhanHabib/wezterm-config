    "editor.fontWeight": "1000",

    // Hide horizontal and vertical scrollbars
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",

    // Disable scrolling in the editor
    "editor.scrollBeyondLastLine": false,
    "editor.cursorSurroundingLines": 0,

    // Disable minimap (which can affect scrolling)
    "editor.minimap.enabled": false,

    // Disable mouse wheel scrolling
    "editor.mouseWheelScrollSensitivity": 0,
    "editor.mouseWheelZoom": false,

    // Hide overview ruler (right-side scrollbar area)
    "editor.hideCursorInOverviewRuler": true,
    "editor.overviewRulerBorder": false,

    // Ensure the editor doesn't allow extra space for scrolling
    "editor.wordWrap": "on",
    "editor.wordWrapColumn": 0,
    "editor.smoothScrolling": false,
    "liveServer.settings.donotShowInfoMsg": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "prettier.tabWidth": 4,

    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,

    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1,
    },

    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "k"],
            "after": ["<Esc>"],
        },
    ],
    "[javascriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features",
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features",
    },
    "javascript.updateImportsOnFileMove.enabled": "always",
    "workbench.colorCustomizations": {},
    // "vscode_vibrancy.theme": "Dark (Exclude Tab Line)",
    "vscode_vibrancy.theme": "GitHub Dark Default",
    "terminal.integrated.env.windows": {},
    "security.workspace.trust.untrustedFiles": "open",

    "terminal.integrated.fontSize": 25,
    "window.zoomPerWindow": false,
    // Increase problems/output/debug console font size
    "editor.codeLensFontSize": 20,
    // "window.titleBarStyle": "native",

    "custom-ui-style.electron": {
        "titleBarStyle": "hiddenInset",

        "trafficLightPosition": {
            "x": 20,
            "y": 16,
        },
    },
    // "workbench.editor.showTabs": "single",
    // "window.zoomLevel": 3,
    "editor.lineHeight": 1.1,
    "[cpp]": {
        "editor.wordBasedSuggestions": "off",
        "editor.semanticHighlighting.enabled": true,
        "editor.stickyScroll.defaultModel": "foldingProviderModel",
        "editor.suggest.insertMode": "replace",
    },

    "vscode_vibrancy.opacity": 0.9,

    "terminal.integrated.gpuAcceleration": "off", // "window.zoomLevel": 1,
    "window.titleBarStyle": "custom",
    // // // "workbench.colorTheme": "Visual Studio Dark",
    "window.controlsStyle": "hidden",
    "workbench.editor.showTabs": "single",

    "background.fullscreen": {
        // Local images can be dragged into the browser to quickly get the file protocol address from the address bar
        "style": {
            "background-position": "100% 100%",
            // "background-size": "auto",
            // "opacity": 0.6
        },
        "images": [
            "https://i1-c.pinimg.com/736x/f3/4a/53/f34a53047f0de65893e7b0e4758bec59.jpg",
        ],
        "opacity": 0.2,
        "size": "cover",
        "position": "center",
        "interval": 0,
        "random": false,
    },
    //     "background.fullscreen": {
    //     "style": {
    //         "background-position": "100% 100%",
    //         "opacity": 0.6
    //     },
    //     // "size": "auto",
    //     // "position": "center",
    //     "interval": 0,
    //     "random": false
    // }

    // `sidebar` and `panel` have the same config as `fullscreen`
    "background.sidebar": {},
    "background.panel": {},

    "workbench.iconTheme": "material-icon-theme",
    "workbench.colorTheme": "Hyper Term Black",
    "python.defaultInterpreterPath": "C:\\Python313\\python.exe",
    "files.associations": {
        "*.py": "python",
    },
    // "workbench.layoutControl.enabled": false,
    "editor.stickyScroll.enabled": false,
    "workbench.editor.editorActionsLocation": "hidden",
    "window.customTitleBarVisibility": "never",

    // Changes the title text shown in the VS Code window (works natively)
    // Customize as you like, e.g. "MyCode — ${rootName}"

    // "window.title": "MyCode — ${rootName}",
    "window.title": "mee",
    // Optional: if you use a file/product icon theme, set it here
    // (does NOT change the app/taskbar icon)
    // "workbench.iconTheme": "material-icon-theme",
    // "workbench.productIconTheme": "fluent-icons",

    // The entries below are custom placeholders for your tooling.
    // They won't change VS Code by themselves, but an extension/launcher
    // could read these to apply branding.

    // Branding name overrides
    "customApp.branding.nameShort": "MyCode",
    "customApp.branding.nameLong": "My Visual Studio Code",

    // Point to a single logo file (PNG/SVG/ICO) or a folder with multiple sizes
    // "customApp.branding.logoPath": "D:\\Brand\\logo.png",
    // "customApp.branding.logoFolder": "D:\\Brand\\logos\\",

    // If you host the logo online
    //   "customApp.branding.logoUrl": "",

    // // Optional: explicit icon files by size/type for a packager/launcher

    // "customApp.branding.icon256": "D:\\Brand\\icon-256.png",

    "glassit.alpha": 255,
    "window.menuBarVisibility": "compact",
    "terminal.integrated.initialHint": false,

    "editor.fontFamily": "JetBrains Mono",
    "editor.fontLigatures": true,

    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "editor.cursorSmoothCaretAnimation": "on",
}
